Options -Indexes
<FilesMatch "^(\.84pad-root\.php|84pad-bundle\.zip|\.env.*|.*\.(zip|pad|bak|sql|log))$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
